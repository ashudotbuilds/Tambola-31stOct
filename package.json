{
  "name": "technical-tambola",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @tambola/api\" \"npm run dev -w @tambola/web\"",
    "dev:web": "npm run dev -w @tambola/web",
    "dev:api": "npm run dev -w @tambola/api",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build -w @tambola/web",
    "build:api": "npm run build -w @tambola/api",
    "start": "npm run start -w @tambola/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @tambola/api",
    "db:migrate": "npm run db:migrate -w @tambola/api",
    "db:migrate:prod": "npm run db:migrate:prod -w @tambola/api",
    "db:status": "npm run db:status -w @tambola/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
