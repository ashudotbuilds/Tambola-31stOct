VITE_API_URL=http://localhost:3001
# PostHog public project token (phc_, never a personal phx_ key).
VITE_POSTHOG_PROJECT_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
# Optional private BUILD credential; never prefix this key with VITE_.
# POSTHOG_CLI_API_KEY=your_error_tracking_write_personal_key
# POSTHOG_CLI_PROJECT_ID=687005
# POSTHOG_CLI_HOST=https://us.posthog.com
