{
  "name": "tambola-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:demo": "tsx test/demo-server.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsup && node scripts/upload-sourcemaps.mjs",
    "start": "npm run db:migrate:prod && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "db:status": "tsx src/db/migrate.ts --status",
    "test:browser": "tsx test/browser-server.ts",
    "posthog:verify": "tsx scripts/verify-posthog.ts",
    "posthog:verify:errors": "tsx scripts/verify-posthog-errors.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "posthog-node": "^5.57.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@posthog/cli": "^0.18.12",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.0",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
