# Pooled Neon connection string for the application. Never expose this to Vite.
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=require
# Optional direct connection for migrations; falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
PORT=3001
HOST=0.0.0.0
# Comma-separated exact frontend origins; include localhost only for development.
WEB_ORIGINS=http://localhost:5173
NODE_ENV=development
# Temporary public role login shortcuts, also enabled in production while testing.
# Set false and restart to hide buttons, suspend test users, and revoke their sessions.
TEST_ACCOUNTS_ENABLED=true
DATABASE_POOL_MAX=10
# Set to 1 behind Render's single proxy; set to 0 for a direct local server.
TRUST_PROXY_HOPS=0
# Optional PostHog logs, error tracking, and game events. Use the same project as Vercel.
# POSTHOG_PROJECT_KEY=phc_your_project_token
# POSTHOG_HOST=https://us.i.posthog.com
# Optional email provider HTTP API (Bearer token + JSON {from,to,subject,text}).
# Leave these unset when email delivery is not configured; enable all together.
# EMAIL_API_URL=https://your-provider.example/send
# EMAIL_API_KEY=your-provider-api-key
# EMAIL_FROM=noreply@your-domain.example
# Optional initial Super Admin bootstrap; use a unique random secret of 32+ characters.
# SUPER_ADMIN_BOOTSTRAP_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
